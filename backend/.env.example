# Exact frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO
FEEDBACK_PATH=data/feedback.jsonl
